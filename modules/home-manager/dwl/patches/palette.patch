+	int drm_fd, i, sig[] = {SIGCHLD, SIGINT, SIGTERM, SIGPIPE, SIGUSR1, SIGUSR2};
 	struct sigaction sa = {.sa_flags = SA_RESTART, .sa_handler = handlesig};
 	sigemptyset(&sa.sa_mask);
 
@@ -2830,6 +2864,14 @@ setup(void)
 	dpy = wl_display_create();
 	event_loop = wl_display_get_event_loop(dpy);
 
+	if (pipe(palette_pipe) < 0)
+		die("pipe:");
+	for (i = 0; i < 2; i++) {
+		fcntl(palette_pipe[i], F_SETFD, FD_CLOEXEC);
+		fcntl(palette_pipe[i], F_SETFL, O_NONBLOCK);
+	}
+	wl_event_loop_add_fd(event_loop, palette_pipe[0], WL_EVENT_READABLE, setpalette, NULL);
+
