@@ -504,6 +509,13 @@ static struct wlr_xwayland *xwayland;
 /* configuration, allows nested code to access above variables */
 #include "config.h"
 
+/* palettes[] rows are { root, border, focus, urgent }; SIGUSR1 selects
+ * palettes[0] and SIGUSR2 palettes[1] at runtime */
+#define rootcolor   (palettes[palette][0])
+#define bordercolor (palettes[palette][1])
+#define focuscolor  (palettes[palette][2])
+#define urgentcolor (palettes[palette][3])
+
 /* attempt to encapsulate suck into one file */
 #include "client.h"
 
@@ -1920,6 +1932,12 @@ handlesig(int signo)
 		while (waitpid(-1, NULL, WNOHANG) > 0);
 	else if (signo == SIGINT || signo == SIGTERM)
 		quit(NULL);
+	else if (signo == SIGUSR1 || signo == SIGUSR2) {
+		int saved_errno = errno;
+		unsigned char p = signo == SIGUSR2;
+		if (write(palette_pipe[1], &p, 1) < 0) {}
+		errno = saved_errno;
+	}
 }
 
 void
@@ -2791,6 +2809,22 @@ setmon(Client *c, Monitor *m, uint32_t newtags)
 	focusclient(focustop(selmon), 1);
 }
 
+int
+setpalette(int fd, uint32_t mask, void *data)
+{
+	unsigned char p;
+	Client *c, *sel = focustop(selmon);
+
+	while (read(fd, &p, 1) == 1)
+		palette = MIN(p, LENGTH(palettes) - 1);
+
+	wlr_scene_rect_set_color(root_bg, rootcolor);
+	wl_list_for_each(c, &clients, link)
+		client_set_border_color(c, c->isurgent ? urgentcolor
+				: c == sel ? focuscolor : bordercolor);
+	return 0;
+}
+
 void
